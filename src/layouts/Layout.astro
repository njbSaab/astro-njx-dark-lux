---
// Maren (astro-njx-boutique) — base layout: announcement bar, header with live cart button,
// cart drawer (client-side, nanostores), footer.
import '../styles/global.css';
import { commerce, providerName } from '../lib/commerce';
import { SITE, ANNOUNCEMENT, HEADER, SEARCH, FOOTER, THANKS_MODAL, CART, NAV_DRAWER } from '../constants/components';

interface Props {
  title?: string;
  description?: string;
  /** Home passes true: header starts transparent over the hero, blurs on scroll */
  overlayHeader?: boolean;
  /** Content pages: white background, black elements (light-section remap) */
  lightPage?: boolean;
}

const {
  title = SITE.defaultTitle,
  description = SITE.defaultDescription,
  overlayHeader = false,
  lightPage = false,
} = Astro.props;

// Active nav item: bg-tile/text-ink are tokens, they follow the theme automatically
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
const navCls = (href: string, base: string, active: string) =>
  `${base} ${isActive(href) ? active : ""}`.trim();

// Client-side product index: powers search, saved-for-later AND the quick-view
// popup (small catalog → inline JSON is the right tool)
const searchIndex = JSON.stringify(
  (await commerce.listProducts()).map((p) => ({
    handle: p.handle,
    title: p.title,
    price: p.price.amount,
    compareAt: p.compareAtPrice?.amount ?? null,
    desc: p.description,
    variants: p.variants.map((v) => ({ id: v.id, title: v.title, available: v.available })),
    variantId: p.variants.find((v) => v.available)?.id ?? p.variants[0]?.id ?? p.id,
    tags: p.tags.join(' '),
    image: p.images[0]?.src ?? '',
    meta: p.meta ?? null,
  })),
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // restore theme before first paint (no flash)
      if (localStorage.getItem('njx-roast-theme') === 'dark') {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="bg-paper font-sans text-ink antialiased" data-provider={providerName} data-search-index={searchIndex}>
    <p class="flex flex-wrap items-center justify-center gap-x-2 bg-brand px-4 py-2 text-center text-[13px] font-medium text-[#0a0a0a]">
      <span>{ANNOUNCEMENT.text}</span>
      <button
        type="button"
        data-copy-promo={ANNOUNCEMENT.promoCode}
        data-copied-label={ANNOUNCEMENT.copiedLabel}
        class="rounded border border-[#0a0a0a]/40 px-2 py-0.5 font-mono text-[12px] font-bold tracking-wide transition hover:bg-[#0a0a0a]/10"
      >{ANNOUNCEMENT.promoCode}</button>
      <span class="opacity-50">·</span>
      <a
        href={ANNOUNCEMENT.linkHref}
        target="_blank"
        rel="noopener"
        class="font-semibold underline underline-offset-2 hover:opacity-80"
      >{ANNOUNCEMENT.linkLabel}</a>
    </p>

    <!-- logo — nav — controls · transparent on home, blurs on scroll -->
    <header id="site-header" class:list={['sticky top-0 z-40 w-full transition-colors duration-300', overlayHeader ? 'header-overlay' : 'is-solid']}>
      <div>
      <nav class="mx-auto grid h-[76px] max-w-6xl grid-cols-[auto_1fr_auto] items-center gap-4 px-3 sm:px-5">
        <a href="/" class="flex items-center gap-2.5 justify-self-start font-bold uppercase tracking-[0.32em] text-[17px]">
          <!-- target-circle mark from the style-book -->
          <span class="relative inline-block h-[22px] w-[22px] border-2 border-current" style="border-radius:50%">
            <span class="absolute inset-[5px] bg-current" style="border-radius:50%"></span>
          </span>
          {SITE.name}
        </a>
        <div class="hidden items-center justify-center gap-1.5 sm:flex">
          {HEADER.navLinks.map((l) => (
            <a href={l.href} class={navCls(l.href, "border border-current/0 px-3.5 py-[7px] text-[13px] font-medium uppercase tracking-[0.18em] transition hover:border-current", "border-current")}>{l.label}</a>
          ))}
        </div>
        <div class="flex items-center gap-1.5 justify-self-end">
          <button id="search-button" class="grid h-10 w-10 place-items-center border border-transparent transition hover:border-current" aria-label={HEADER.aria.search} aria-expanded="false">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
              <circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" />
            </svg>
          </button>
          <button
            id="cart-button"
            class="flex h-10 items-center gap-2 border border-transparent px-3 transition hover:border-current"
            aria-label={HEADER.aria.cart}
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="9" cy="21" r="1.4" />
              <circle cx="19" cy="21" r="1.4" />
              <path d="M2.5 3h2l2.6 12.6a2 2 0 0 0 2 1.6h9.2a2 2 0 0 0 2-1.6L22 7H6" />
            </svg>
            <span id="cart-count" class="text-[13px] font-medium tracking-wide">0</span>
          </button>
          <a href="/account" class="hidden h-10 w-10 place-items-center border border-transparent transition hover:border-current sm:grid" aria-label={HEADER.aria.account}>
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5" />
            </svg>
          </a>
          <button id="nav-button" class="grid h-10 w-10 place-items-center border border-transparent transition hover:border-current" aria-label={HEADER.aria.menu} aria-expanded="false">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
              <path d="M3 5.5h14M3 10h14M3 14.5h14" />
            </svg>
          </button>
        </div>
      </nav>
      <!-- search panel -->
      <div id="search-panel" class="hidden border-t border-line bg-paper">
        <div class="mx-auto max-w-6xl px-5 py-4">
          <div class="flex items-center gap-3 rounded-md border border-line px-4 focus-within:border-brand">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" class="shrink-0 text-muted">
              <circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" />
            </svg>
            <input
              id="search-input"
              type="search"
              placeholder={SEARCH.placeholder}
              class="w-full bg-transparent py-3 text-[15px] outline-none placeholder:text-muted"
              autocomplete="off"
            />
            <kbd class="hidden rounded border border-line px-1.5 py-0.5 text-[11px] text-muted sm:block">{SEARCH.escHint}</kbd>
          </div>
          <div id="search-results" class="hidden gap-4 py-5 sm:grid-cols-4"></div>
          <p id="search-empty" class="hidden py-6 text-center text-[14px] text-muted">{SEARCH.emptyText}</p>
        </div>
      </div>
    </header>

    <div class:list={[lightPage && 'light-section']}>
      <slot />
    </div>

    <footer class="site-footer w-full">
      <div class="mx-auto max-w-6xl">
      <div class="grid gap-8 px-5 py-8 sm:grid-cols-[1.2fr_1fr] sm:gap-10 sm:px-10 sm:py-12">
        <div>
          <p class="flex items-center gap-2 font-display text-xl font-bold"><img src={SITE.logoDark} alt="" class="logo-on-light h-7 w-7 rounded-md" /><img src={SITE.logoLight} alt="" class="logo-on-dark h-7 w-7 rounded-md" />{SITE.name}</p>
          <p class="mt-3 max-w-[36ch] text-[14px] leading-relaxed text-muted">{FOOTER.tagline}</p>
        </div>
        <nav class="grid grid-cols-2 gap-8 text-[14px] sm:grid-cols-3" aria-label="Footer">
          {FOOTER.columns.map((col) => (
            <div>
              <p class="font-semibold">{col.title}</p>
              <ul class="mt-3 space-y-2 text-muted">
                {col.links.map((l) => (
                  <li>
                    <a
                      href={l.href}
                      class={l.href.startsWith('/')
                        ? navCls(l.href, "hover:text-ink hover:underline underline-offset-4", "text-ink font-semibold underline")
                        : "hover:text-ink hover:underline underline-offset-4"}
                    >{l.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      </div>
      <!-- ── Built with: the theme's tech stack ── -->
      <!-- mobile: reversed column — logos on top, legal links below -->
      <div class="flex flex-col-reverse items-center gap-y-4 border-t border-line px-5 py-4 sm:flex-row sm:flex-wrap sm:justify-between sm:gap-x-8 sm:px-10 sm:py-5">
        <div class="flex flex-wrap items-center gap-5 text-[13px] text-muted">
          {FOOTER.legalLinks.map((l) => (
            <a href={l.href} class={navCls(l.href, "hover:text-ink hover:underline underline-offset-4", "text-ink font-semibold underline")}>{l.label}</a>
          ))}
        </div>
        <!-- mobile: 3+2 grid with a centered second row; sm+: single row -->
        <div class="tech-row grid w-full grid-cols-6 items-center justify-items-center gap-y-3 sm:flex sm:w-auto sm:flex-wrap sm:gap-5">
          <img src="/tech/astro.png" alt="Astro" title="Astro" class="col-span-2 h-9 w-auto" loading="lazy" />
          <img src="/tech/tailwind.png" alt="Tailwind CSS" title="Tailwind CSS" class="col-span-2 h-7 w-auto" loading="lazy" />
          <img src="/tech/nodejs.png" alt="Node.js" title="Node.js" class="col-span-2 h-9 w-auto" loading="lazy" />
          <img src="/tech/shopify.png" alt="Shopify" title="Shopify" class="col-span-2 col-start-2 h-9 w-auto" loading="lazy" />
          <img src="/tech/cloudflare.png" alt="Cloudflare" title="Cloudflare" class="col-span-2 h-9 w-auto" loading="lazy" />
        </div>
      </div>
      </div>
    </footer>

    <!-- ── Quick view popup: dark blurred overlay, white product card,
         the header stays visible above it (spec: cartenoire-style) ── -->
    <div id="quickview" class="fixed inset-0 z-30 grid hidden place-items-center overflow-y-auto px-3 py-20 sm:px-5 sm:py-24" role="dialog" aria-modal="true" aria-label="Product quick view">
      <div class="qv-backdrop absolute inset-0" data-qv-close></div>
      <div class="relative mx-auto grid w-full max-w-4xl bg-white text-[#0a0a0a] md:grid-cols-2">
        <button data-qv-close class="absolute right-0 top-0 z-10 grid h-[52px] w-[52px] place-items-center bg-black text-[22px] leading-none text-white transition hover:bg-[#333]" aria-label="Close quick view">×</button>
        <div class="relative min-h-[300px] bg-[#141210] md:min-h-[420px]">
          <img data-qv-img src="" alt="" class="absolute inset-0 h-full w-full object-cover" />
        </div>
        <div class="flex flex-col p-5 sm:p-8 md:p-11">
          <p data-qv-category class="mb-2 text-[10px] uppercase tracking-[0.3em] text-[#666] sm:mb-3 sm:text-[11px]"></p>
          <h3 data-qv-title class="mb-3 font-display text-[clamp(20px,5vw,30px)] font-semibold uppercase leading-[1.05] tracking-[0.02em]"></h3>
          <p class="mb-4 text-[16px] sm:text-[18px]">
            <s data-qv-compare class="mr-2 hidden text-[14px] text-[#999]"></s>
            <span data-qv-price class="font-semibold"></span>
          </p>
          <p data-qv-desc class="mb-6 text-[14px] leading-relaxed text-[#333]"></p>
          <!-- spec grid: hairline 2×2 (style-book) -->
          <div class="mb-5 grid grid-cols-2 gap-px border border-black/15 bg-black/15 text-[12px] sm:mb-6 sm:text-[13px]">
            <div class="bg-white p-2.5 sm:p-3.5"><span class="mb-1 block text-[10px] uppercase tracking-[0.2em] text-[#777]">Origin</span><span data-qv-origin></span></div>
            <div class="bg-white p-2.5 sm:p-3.5"><span class="mb-1 block text-[10px] uppercase tracking-[0.2em] text-[#777]">Notes</span><span data-qv-notes></span></div>
            <div class="bg-white p-2.5 sm:p-3.5"><span class="mb-1 block text-[10px] uppercase tracking-[0.2em] text-[#777]">Format</span><span data-qv-format></span></div>
            <div class="bg-white p-2.5 sm:p-3.5"><span class="mb-1 block text-[10px] uppercase tracking-[0.2em] text-[#777]">Ships</span>Within 48 h</div>
          </div>
          <div data-qv-variants class="flex flex-wrap gap-2"></div>
          <div class="mt-auto flex gap-2 pt-6">
            <button data-qv-add class="flex-1 bg-black py-3.5 text-[13px] font-semibold uppercase tracking-[0.18em] text-white transition hover:bg-[#333]">Add to cart</button>
            <button data-qv-fav class="grid w-[52px] place-items-center border border-black/20 text-[#0a0a0a] transition hover:border-black" aria-label="Save for later">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 20.5c-5.5-3.6-8.5-6.9-8.5-10.4A4.6 4.6 0 0 1 8.1 5.4c1.6 0 3 .8 3.9 2.1a4.7 4.7 0 0 1 3.9-2.1 4.6 4.6 0 0 1 4.6 4.7c0 3.5-3 6.8-8.5 10.4z" />
              </svg>
            </button>
          </div>
          <a data-qv-link href="#" class="mt-4 text-center text-[12px] uppercase tracking-[0.18em] text-[#666] underline underline-offset-4 hover:text-black">Full details →</a>
        </div>
      </div>
    </div>

    <!-- ── Demo thank-you modal ── -->
    <div id="thanks-modal" class="fixed inset-0 z-[60] hidden items-center justify-center p-5">
      <div class="absolute inset-0 bg-ink/50" data-thanks-close></div>
      <div class="light-section relative w-full max-w-sm p-8 text-center">
        <button data-thanks-close class="absolute right-0 top-0 z-10 grid h-[52px] w-[52px] place-items-center bg-black text-[22px] leading-none text-white transition hover:bg-[#333]" aria-label="Close">×</button>
        <p class="text-4xl">{THANKS_MODAL.emoji}</p>
        <h3 class="mt-3 font-display text-2xl font-semibold uppercase tracking-[0.04em]">{THANKS_MODAL.title}</h3>
        <p class="mt-2 text-[14px] leading-relaxed text-muted">{THANKS_MODAL.text}</p>
        <a
          href={THANKS_MODAL.starHref}
          target="_blank"
          rel="noopener"
          class="mt-5 block w-full bg-black py-3.5 text-[13px] font-semibold uppercase tracking-[0.18em] text-white transition hover:bg-[#333]"
        >{THANKS_MODAL.starLabel}</a>
        <button data-thanks-close class="mt-2 w-full rounded-md py-2.5 text-[14px] text-muted hover:text-ink">
          {THANKS_MODAL.keepLabel}
        </button>
        <p class="mt-3 text-[12px] text-muted">
          Made by <a href={THANKS_MODAL.madeByHref} target="_blank" rel="noopener" class="underline underline-offset-2 hover:text-ink">{THANKS_MODAL.madeByLabel}</a>
        </p>
      </div>
    </div>

    <!-- ── Cart: centered white card over the dark blurred overlay,
         same language as the quick-view popup ── -->
    <div id="cart-backdrop" class="qv-backdrop fixed inset-0 z-40" aria-hidden="true"></div>
    <aside
      id="cart-drawer"
      class="fixed inset-0 z-50 grid place-items-center overflow-y-auto px-5 py-24"
      aria-label={CART.ariaDrawer}
    >
      <div class="light-section relative w-full max-w-2xl">
        <button id="cart-close" class="absolute right-0 top-0 z-10 grid h-[52px] w-[52px] place-items-center bg-black text-[22px] leading-none text-white transition hover:bg-[#333]" aria-label={CART.ariaClose}>×</button>
        <div class="flex items-center justify-between gap-4 px-8 pt-7">
          <h2 class="text-[15px] font-semibold uppercase tracking-[0.24em]">{CART.ariaDrawer}</h2>
          <button id="cart-clear" class="mr-14 hidden text-[12px] uppercase tracking-[0.14em] text-muted underline underline-offset-4 hover:text-ink" aria-label={CART.ariaClear}>
            {CART.clearLabel}
          </button>
        </div>
        <div id="cart-lines" class="px-8 pt-2"></div>
        <!-- Saved for later: favorites live INSIDE the cart, not as a separate page -->
        <div id="cart-saved" class="hidden border-t border-line px-8 py-4">
          <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-muted">{CART.savedTitle}</p>
          <div id="cart-saved-lines"></div>
        </div>
        <div class="border-t border-line px-8 py-6">
          <div class="flex items-center justify-between text-[15px]">
            <span class="text-[12px] uppercase tracking-[0.2em] text-muted">{CART.subtotalLabel}</span>
            <span id="cart-subtotal" class="font-semibold">$0</span>
          </div>
          <p class="mt-1 text-[13px] text-muted">{CART.shippingNote}</p>
          <button
            id="cart-checkout"
            class="mt-5 w-full bg-black py-3.5 text-[13px] font-semibold uppercase tracking-[0.18em] text-white transition hover:bg-[#333] disabled:cursor-not-allowed disabled:opacity-40"
          >
            {CART.checkoutLabel}
          </button>
          <p id="cart-note" class="mt-2 hidden text-center text-[13px] text-muted"></p>
        </div>
      </div>
    </aside>

    <!-- ── Fullscreen menu (editorial takeover, not a side drawer) ── -->
    <div id="nav-backdrop" class="hidden" aria-hidden="true"></div>
    <aside id="nav-drawer" class="fixed inset-0 z-50 flex flex-col overflow-hidden bg-paper" aria-label={NAV_DRAWER.ariaDrawer}>
      <div class="border-b border-line">
        <div class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between px-5">
          <h2 class="font-display text-[26px] font-medium tracking-[0.04em]">{SITE.name}</h2>
          <button id="nav-close" class="p-2 text-muted transition hover:bg-tile hover:text-ink" aria-label={NAV_DRAWER.ariaClose}>
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
          </button>
        </div>
      </div>
      <!-- utility row under the header line: account / theme, icon + label -->
      <div class="mx-auto flex w-full max-w-6xl items-center gap-x-7 px-5 pt-4">
        <a href="/account" class="flex items-center gap-2 text-[16px] text-muted hover:text-ink hover:underline underline-offset-4">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5" />
          </svg>
          Account
        </a>
        <button data-open-cart class="flex items-center gap-2 text-[16px] text-muted hover:text-ink hover:underline underline-offset-4" aria-label={HEADER.aria.cart}>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1.4" /><circle cx="19" cy="21" r="1.4" /><path d="M2.5 3h2l2.6 12.6a2 2 0 0 0 2 1.6h9.2a2 2 0 0 0 2-1.6L22 7H6" />
          </svg>
          Cart
        </button>
      </div>
      <nav class="mx-auto flex w-full max-w-6xl flex-1 flex-col justify-center gap-1 overflow-y-auto px-5">
        {[NAV_DRAWER.home, ...NAV_DRAWER.collections].map((l) => (
          <a href={l.href} class={navCls(l.href, "menu-link group flex items-baseline gap-4 self-start py-3 font-display text-[clamp(22px,7vw,44px)] uppercase leading-tight tracking-[0.06em]", "is-active")}>
            {l.label}
            <span class="-translate-x-2 text-[22px] font-sans text-muted opacity-0 transition duration-300 group-hover:translate-x-0 group-hover:opacity-100">→</span>
          </a>
        ))}
        <div class="mt-6 flex flex-wrap gap-x-8 gap-y-2">
          {NAV_DRAWER.pages.map((l) => (
            <a href={l.href} class={navCls(l.href, "text-[16px] text-muted hover:text-ink hover:underline underline-offset-4", "text-ink underline underline-offset-4")}>{l.label}</a>
          ))}
        </div>
      </nav>
      <div class="mx-auto w-full max-w-6xl border-t border-line px-5 py-5 text-[13px] text-muted">
        {NAV_DRAWER.footer.builtWithLabel} <a href={NAV_DRAWER.footer.libHref} class="underline underline-offset-2 hover:text-ink">{NAV_DRAWER.footer.libLabel}</a> ·
        <a href={NAV_DRAWER.footer.starHref} class="underline underline-offset-2 hover:text-ink">{NAV_DRAWER.footer.starLabel}</a>
      </div>
    </aside>

    <script>
      import { cartLines, setQuantity, cartCount, cartTotal, clearCart } from '../lib/cart';
      import { favorites, toggleFavorite } from '../lib/favorites';
      import { CART } from '../constants/components';
      import type { CartLine } from '../lib/commerce/types';

      const $ = (id: string) => document.getElementById(id)!;
      const provider = document.body.dataset.provider;

      function money(n: number) {
        return '$' + (Math.round(n * 100) / 100).toString();
      }

      function render() {
        const lines = cartLines.get();
        const countEl = $('cart-count');
        const n = cartCount();
        countEl.textContent = String(n);
        

        const box = $('cart-lines');
        if (!lines.length) {
          box.innerHTML =
            `<p class="py-16 text-center text-[15px] text-muted">${CART.emptyLine1}<br/>${CART.emptyLine2}</p>`;
        } else {
          box.innerHTML = lines
            .map(
              (l) => `
              <div class="relative flex gap-4 border-b border-line py-4" data-line="${l.variantId}">
                <button class="absolute right-0 top-4 rounded-md p-1.5 text-muted transition hover:bg-tile hover:text-ink" data-remove aria-label="Remove ${l.title} from cart">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
                </button>
                ${l.image ? `<img src="${l.image.src}" alt="" class="h-20 w-20 rounded-md bg-tile object-cover"/>` : ''}
                <div class="flex-1 pr-8">
                  <p class="text-[15px] font-medium">${l.title}</p>
                  <p class="text-[13px] text-muted">${l.variantTitle}</p>
                  <div class="mt-2 flex items-center gap-3">
                    <div class="flex items-center rounded-md border border-line">
                      <button class="px-2.5 py-1 text-muted hover:text-ink" data-qty="-1" aria-label="Decrease quantity">−</button>
                      <span class="px-1 text-[14px]">${l.quantity}</span>
                      <button class="px-2.5 py-1 text-muted hover:text-ink" data-qty="1" aria-label="Increase quantity">+</button>
                    </div>
                    <span class="text-[14px] font-medium">${money(l.price.amount * l.quantity)}</span>
                  </div>
                </div>
              </div>`,
            )
            .join('');
        }
        $('cart-subtotal').textContent = money(cartTotal());
        ($('cart-checkout') as HTMLButtonElement).disabled = lines.length === 0;
        $('cart-clear').classList.toggle('hidden', lines.length === 0);
      }

      function open() {
        document.body.classList.add('cart-open');
      }
      function close() {
        document.body.classList.remove('cart-open');
      }

      // ── Theme toggle: header button (desktop) + drawer button (mobile) ──
      const themeToggles = document.querySelectorAll<HTMLElement>('[data-theme-toggle]');
      function syncThemeIcon() {
        const dark = document.documentElement.classList.contains('dark');
        themeToggles.forEach((btn) => {
          btn.querySelector('[data-icon-moon]')?.classList.toggle('hidden', dark);
          btn.querySelector('[data-icon-sun]')?.classList.toggle('hidden', !dark);
        });
      }
      themeToggles.forEach((btn) =>
        btn.addEventListener('click', () => {
          const dark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('njx-roast-theme', dark ? 'dark' : 'light');
          syncThemeIcon();
        })
      );
      syncThemeIcon();

      // ── Search ──
      const searchPanel = $('search-panel');
      const searchInput = $('search-input') as HTMLInputElement;
      const searchResults = $('search-results');
      const searchEmpty = $('search-empty');
      const index: { handle: string; title: string; price: number; tags: string; image: string }[] =
        JSON.parse(document.body.dataset.searchIndex!);

      function renderSearch(q: string) {
        // empty query — show the whole catalog
        const hits = q
          ? index.filter((p) => (p.title + ' ' + p.tags).toLowerCase().includes(q)).slice(0, 8)
          : index;
        searchEmpty.classList.toggle('hidden', hits.length > 0);
        searchResults.classList.toggle('hidden', hits.length === 0);
        searchResults.classList.toggle('grid', hits.length > 0);
        searchResults.innerHTML = hits
          .map(
            (p) => `
            <a href="/products/${p.handle}" class="group flex items-center gap-3 rounded-md p-2 hover:bg-tile">
              <img src="${p.image}" alt="" class="h-14 w-14 rounded-md bg-tile object-cover"/>
              <span class="min-w-0">
                <span class="block truncate text-[14px] font-medium group-hover:underline group-hover:underline-offset-4">${p.title}</span>
                <span class="text-[13px] text-muted">$${p.price}</span>
              </span>
            </a>`,
          )
          .join('');
      }

      function toggleSearch(show?: boolean) {
        const willShow = show ?? searchPanel.classList.contains('hidden');
        searchPanel.classList.toggle('hidden', !willShow);
        $('search-button').setAttribute('aria-expanded', String(willShow));
        if (willShow) {
          renderSearch(searchInput.value.trim().toLowerCase());
          searchInput.focus();
        }
      }
      $('search-button').addEventListener('click', () => toggleSearch());
      searchInput.addEventListener('input', () => renderSearch(searchInput.value.trim().toLowerCase()));


      function openNav() { document.body.classList.add('nav-open'); }
      function closeNav() { document.body.classList.remove('nav-open'); }
      $('nav-button').addEventListener('click', openNav);
      $('nav-close').addEventListener('click', closeNav);
      $('nav-backdrop').addEventListener('click', closeNav);

      $('cart-button').addEventListener('click', open);
      document.querySelectorAll('[data-open-cart]').forEach((b) =>
        b.addEventListener('click', () => { closeNav(); open(); }),
      );
      $('cart-close').addEventListener('click', close);
      $('cart-clear').addEventListener('click', clearCart);
      $('cart-backdrop').addEventListener('click', close);
      function closeThanks() {
        const modal = $('thanks-modal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
      document.querySelectorAll('[data-thanks-close]').forEach((el) => el.addEventListener('click', closeThanks));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          close();
          closeThanks();
          closeNav();
          closeQuickview();
          toggleSearch(false);
        }
        if (e.key === '/' && document.activeElement?.tagName !== 'INPUT' && document.activeElement?.tagName !== 'TEXTAREA') {
          e.preventDefault();
          toggleSearch(true);
        }
      });

      $('cart-lines').addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const removeBtn = target.closest('[data-remove]');
        if (removeBtn) {
          const row = removeBtn.closest('[data-line]') as HTMLElement;
          setQuantity(row.dataset.line!, 0);
          return;
        }
        const btn = target.closest('[data-qty]') as HTMLElement | null;
        if (!btn) return;
        const row = btn.closest('[data-line]') as HTMLElement;
        const line = cartLines.get().find((l) => l.variantId === row.dataset.line);
        if (line) setQuantity(line.variantId, line.quantity + Number(btn.dataset.qty));
      });

      // Add-to-cart: any element with data-cart-line='{json CartLine}'
      document.addEventListener('click', (e) => {
        const el = (e.target as HTMLElement).closest('[data-cart-line]') as HTMLElement | null;
        if (!el) return;
        const line = JSON.parse(el.dataset.cartLine!) as CartLine;
        // PDP qty & variant picker apply ONLY to the main PDP button — a quick-add
        // on a related-products card must not inherit another product's variant/qty.
        if (!el.hasAttribute('data-quick-add')) {
          const qtyInput = document.querySelector('[data-qty-input]') as HTMLInputElement | null;
          line.quantity = qtyInput ? Math.max(1, Number(qtyInput.value)) : 1;
          const picked = document.querySelector('[data-variant-picker] [aria-pressed="true"]') as HTMLElement | null;
          if (picked) {
            line.variantId = picked.dataset.variantId!;
            line.variantTitle = picked.dataset.variantTitle!;
          }
        }
        import('../lib/cart').then(({ addLine }) => {
          addLine(line);
          open();
        });
      });

      $('cart-checkout').addEventListener('click', async () => {
        const lines = cartLines.get();
        if (!lines.length) return;
        const note = $('cart-note');
        if (provider !== 'shopify') {
          close();
          const modal = $('thanks-modal');
          modal.classList.remove('hidden');
          modal.classList.add('flex');
          return;
        }
        const btn = $('cart-checkout') as HTMLButtonElement;
        btn.disabled = true;
        btn.textContent = CART.checkoutPreparing;
        try {
          const res = await fetch(
            `https://${import.meta.env.PUBLIC_SHOPIFY_DOMAIN}/api/2025-07/graphql.json`,
            {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'X-Shopify-Storefront-Access-Token': import.meta.env.PUBLIC_SHOPIFY_STOREFRONT_TOKEN,
              },
              body: JSON.stringify({
                query: `mutation ($lines: [CartLineInput!]!) {
                  cartCreate(input: { lines: $lines }) { cart { checkoutUrl } userErrors { message } }
                }`,
                variables: {
                  lines: lines.map((l) => ({ merchandiseId: l.variantId, quantity: l.quantity })),
                },
              }),
            },
          );
          const json = await res.json();
          const url = json.data?.cartCreate?.cart?.checkoutUrl;
          if (url) location.href = url;
          else throw new Error(json.data?.cartCreate?.userErrors?.[0]?.message ?? 'cartCreate failed');
        } catch (err) {
          note.textContent = CART.checkoutFailedPrefix + (err as Error).message;
          note.classList.remove('hidden');
          btn.disabled = false;
          btn.textContent = CART.checkoutLabel;
        }
      });

      // ── Saved for later: hearts save INTO the cart drawer, no separate page ──
      type IndexItem = { handle: string; title: string; price: number; variantId: string; image: string };
      const productIndex: IndexItem[] = JSON.parse(document.body.dataset.searchIndex!);

      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-fav-toggle]');
        if (!btn) return;
        const wasSaved = favorites.get().includes(btn.dataset.favToggle!);
        toggleFavorite(btn.dataset.favToggle!);
        if (!wasSaved) open(); // show the drawer so the save is visible immediately
      });

      function renderSaved() {
        const list = favorites.get();
        document.querySelectorAll<HTMLElement>('[data-fav-toggle]').forEach((b) => {
          b.classList.toggle('is-fav', list.includes(b.dataset.favToggle!));
        });
        const wrap = $('cart-saved');
        const box = $('cart-saved-lines');
        const items = productIndex.filter((p) => list.includes(p.handle));
        wrap.classList.toggle('hidden', items.length === 0);
        box.innerHTML = items
          .map(
            (p) => `
            <div class="flex items-center gap-3 border-b border-line py-3 last:border-b-0" data-saved="${p.handle}">
              <a href="/products/${p.handle}"><img src="${p.image}" alt="" class="h-14 w-14 rounded-md bg-tile object-cover"/></a>
              <div class="min-w-0 flex-1">
                <a href="/products/${p.handle}" class="block truncate text-[14px] font-medium hover:underline underline-offset-2">${p.title}</a>
                <p class="text-[13px] text-muted">$${p.price}</p>
              </div>
              <button data-saved-move class="rounded-md border border-line px-2.5 py-1.5 text-[12px] font-semibold transition hover:border-brand hover:text-brand">${CART.savedMove}</button>
              <button data-saved-remove class="rounded-md p-1.5 text-muted transition hover:bg-tile hover:text-ink" aria-label="${CART.savedRemoveAria(p.title)}">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
              </button>
            </div>`,
          )
          .join('');
      }

      $('cart-saved-lines').addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const row = target.closest<HTMLElement>('[data-saved]');
        if (!row) return;
        const handle = row.dataset.saved!;
        if (target.closest('[data-saved-remove]')) {
          toggleFavorite(handle);
          return;
        }
        if (target.closest('[data-saved-move]')) {
          const p = productIndex.find((x) => x.handle === handle);
          if (!p) return;
          import('../lib/cart').then(({ addLine }) => {
            addLine({
              variantId: p.variantId,
              productHandle: p.handle,
              title: p.title,
              variantTitle: 'Default',
              image: p.image ? { src: p.image, alt: p.title } : undefined,
              price: { amount: p.price, currencyCode: 'USD' },
              quantity: 1,
            } as CartLine);
            toggleFavorite(handle);
          });
        }
      });

      favorites.subscribe(renderSaved);
      renderSaved();

      // ── Quick view: intercept card clicks, render from the inline index.
      // Direct /products/ URLs still hit the full page — SEO keeps its pages. ──
      type QvVariant = { id: string; title: string; available: boolean };
      const qv = $('quickview');
      let qvHandle = '';
      let qvVariant: QvVariant | null = null;

      function openQuickview(handle: string) {
        const p = productIndex.find((x) => x.handle === handle) as (IndexItem & {
          desc: string; compareAt: number | null; variants: QvVariant[];
        }) | undefined;
        if (!p) return;
        qvHandle = handle;
        qvVariant = p.variants.find((v) => v.available) ?? p.variants[0] ?? null;
        (qv.querySelector('[data-qv-img]') as HTMLImageElement).src = p.image;
        qv.querySelector('[data-qv-title]')!.textContent = p.title;
        qv.querySelector('[data-qv-category]')!.textContent = p.tags.split(' ')[0] ?? '';
        qv.querySelector('[data-qv-desc]')!.textContent = p.desc;
        qv.querySelector('[data-qv-price]')!.textContent = '$' + p.price;
        const cmp = qv.querySelector('[data-qv-compare]') as HTMLElement;
        cmp.textContent = p.compareAt ? '$' + p.compareAt : '';
        cmp.classList.toggle('hidden', !p.compareAt);
        (qv.querySelector('[data-qv-link]') as HTMLAnchorElement).href = `/products/${p.handle}`;
        const meta = (p as unknown as { meta: { origin?: string; notes?: string; format?: string } | null }).meta;
        qv.querySelector('[data-qv-origin]')!.textContent = meta?.origin ?? '—';
        qv.querySelector('[data-qv-notes]')!.textContent = meta?.notes ?? '—';
        qv.querySelector('[data-qv-format]')!.textContent = meta?.format ?? (qvVariant?.title ?? '—');
        const vbox = qv.querySelector('[data-qv-variants]') as HTMLElement;
        vbox.innerHTML = p.variants.length > 1
          ? p.variants.map((v) => `
              <button type="button" data-qv-variant="${v.id}" data-qv-vtitle="${v.title}" ${v.available ? '' : 'disabled'}
                aria-pressed="${v.id === qvVariant?.id}"
                class="rounded-md border px-3.5 py-1.5 text-[13px] transition ${v.available
                  ? 'border-[#d0d0d0] hover:border-[#120d0a] aria-pressed:border-[#666666] aria-pressed:bg-[#ececec] aria-pressed:font-semibold'
                  : 'cursor-not-allowed border-[#eee6da] text-[#aaaaaa] line-through'}">${v.title}</button>`).join('')
          : '';
        qv.classList.remove('hidden');
        document.body.classList.add('qv-open');
      }
      function closeQuickview() {
        qv.classList.add('hidden');
        document.body.classList.remove('qv-open');
      }

      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        // hover-actions inside the card handle themselves
        if (target.closest('[data-cart-line]') || target.closest('[data-fav-toggle]')) return;
        const card = target.closest<HTMLElement>('[data-quickview]');
        if (!card) return;
        e.preventDefault();
        openQuickview(card.dataset.quickview!);
      });
      qv.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('[data-qv-close]')) return closeQuickview();
        const vbtn = target.closest<HTMLElement>('[data-qv-variant]');
        if (vbtn) {
          qv.querySelectorAll('[data-qv-variant]').forEach((b) => b.setAttribute('aria-pressed', 'false'));
          vbtn.setAttribute('aria-pressed', 'true');
          qvVariant = { id: vbtn.dataset.qvVariant!, title: vbtn.dataset.qvVtitle!, available: true };
          return;
        }
        if (target.closest('[data-qv-add]')) {
          const p = productIndex.find((x) => x.handle === qvHandle);
          if (!p) return;
          import('../lib/cart').then(({ addLine }) => {
            addLine({
              variantId: qvVariant?.id ?? p.variantId,
              productHandle: p.handle,
              title: p.title,
              variantTitle: qvVariant?.title ?? 'Default',
              image: p.image ? { src: p.image, alt: p.title } : undefined,
              price: { amount: p.price, currencyCode: 'USD' },
              quantity: 1,
            } as CartLine);
            closeQuickview();
            open();
          });
          return;
        }
        if (target.closest('[data-qv-fav]')) {
          const had = favorites.get().includes(qvHandle);
          toggleFavorite(qvHandle);
          if (!had) { closeQuickview(); open(); }
        }
      });

      // ── Header: blur once the page scrolls (overlay mode on home) ──
      const hdr = document.getElementById('site-header');
      if (hdr) {
        const syncScroll = () => hdr.classList.toggle('is-scrolled', window.scrollY > 24);
        window.addEventListener('scroll', syncScroll, { passive: true });
        syncScroll();
      }

      // ── Announcement promo code: click to copy ──
      document.querySelectorAll<HTMLButtonElement>('[data-copy-promo]').forEach((btn) => {
        const original = btn.textContent;
        btn.addEventListener('click', async () => {
          await navigator.clipboard.writeText(btn.dataset.copyPromo!);
          btn.textContent = btn.dataset.copiedLabel!;
          setTimeout(() => (btn.textContent = original), 1400);
        });
      });

      cartLines.subscribe(render);
      render();
    </script>
  </body>
</html>
