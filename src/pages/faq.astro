---
import Layout from '../layouts/Layout.astro';
import { FAQ_PAGE as T } from '../constants/pages';
---

<Layout title={T.meta.title} description={T.meta.description} lightPage={true}>
  <!-- title on a white band: black elements on white (style-book contrast) -->
  <section class="light-section">
    <div class="mx-auto max-w-3xl px-5 py-10 sm:py-14">
      <h1 class="font-display text-[clamp(32px,5vw,52px)] font-semibold uppercase tracking-[0.04em]">{T.title}</h1>
      <p class="mt-3 text-[16px] leading-relaxed text-muted" set:html={T.introHtml} />
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 pb-8 sm:pb-16 pt-2">

    <div class="faq-list mt-8 border border-line bg-tile/40">
      {T.items.map((item) => (
        <details class="group border-b border-line px-6 py-4 transition-colors last:border-b-0 sm:px-8">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[15px] font-semibold">
            {item.q}
            <span class="shrink-0 text-muted transition group-open:rotate-45">+</span>
          </summary>
          <p class="max-w-[62ch] pb-1 pt-2.5 text-[14px] leading-relaxed text-muted">{item.a}</p>
        </details>
      ))}
    </div>
  </section>
</Layout>
