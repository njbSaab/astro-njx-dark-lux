---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../constants/components';
import { ABOUT as T } from '../constants/pages';
---

<Layout title={T.meta.title} description={T.meta.description}>
  <section class="mx-auto grid max-w-6xl items-center gap-10 px-5 pb-4 sm:pb-8 pt-6 md:grid-cols-[1.1fr_1fr] md:pt-12">
    <div>
      <img src={SITE.logoDark} alt={`${SITE.name} logo`} class="logo-on-light mb-6 h-16 w-16 rounded-xl" />
      <img src={SITE.logoLight} alt={`${SITE.name} logo`} class="logo-on-dark mb-6 h-16 w-16 rounded-xl" />
      <h1 class="font-display text-[clamp(36px,5vw,60px)] font-extrabold leading-[1.02] tracking-tight">
        {T.hero.title}
      </h1>
      {T.hero.paragraphs.map((p, i) => (
        <p class:list={['max-w-[52ch] text-[16px] leading-relaxed text-muted', i === 0 ? 'mt-5' : 'mt-4']}>{p}</p>
      ))}
    </div>
    <div class="overflow-hidden rounded-xl bg-tile">
      <img src={T.hero.image.src} alt={T.hero.image.alt} class="aspect-[4/5] w-full object-cover" />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5">
    <div class="grid gap-4 rounded-2xl border border-line bg-tile/60 p-4 text-center sm:grid-cols-4 sm:gap-8 sm:p-10">
      {T.numbers.map((n) => (
        <div>
          <p class="font-display text-3xl font-bold text-brand">{n.num}</p>
          <p class="mt-1 text-[14px] text-muted">{n.label}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="theme" class="mx-auto max-w-6xl scroll-mt-24 px-5 pt-4 sm:pt-8">
    <div class="grid gap-5 rounded-2xl border border-line bg-tile/60 p-4 sm:gap-10 sm:p-10 md:grid-cols-2">
      <div>
        <p class="text-[13px] font-medium text-brand">{T.themeBlock.eyebrow}</p>
        <h2 class="mt-3 font-display text-[clamp(24px,3vw,32px)] font-bold leading-tight tracking-tight">
          {T.themeBlock.title}
        </h2>
        <p class="mt-4 text-[15px] leading-relaxed text-muted" set:html={T.themeBlock.textHtml} />
        <a href={T.themeBlock.cta.href} class="mt-6 inline-block rounded-md bg-brand px-6 py-3.5 text-[15px] font-semibold text-white hover:bg-brand-deep">
          {T.themeBlock.cta.label}
        </a>
      </div>
      <div>
        <h3 class="text-[16px] font-semibold">{T.themeBlock.howTitle}</h3>
        <ul class="mt-4 grid gap-4 text-[14px] leading-relaxed text-muted">
          {T.themeBlock.howItemsHtml.map((item) => (
            <li class="flex gap-3">
              <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-brand"></span>
              <span set:html={item} />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="mx-auto flex max-w-3xl flex-col items-center justify-center gap-4 px-5 py-4 sm:py-14 text-center">
    <h2 class="font-display text-2xl font-bold">{T.cta.title}</h2>
    <p class="text-[15px] text-muted">{T.cta.text}</p>
    <a href={T.cta.button.href} class="rounded-md bg-brand px-6 py-3.5 text-[15px] font-semibold text-white hover:bg-brand-deep">
      {T.cta.button.label}
    </a>
  </section>
</Layout>
