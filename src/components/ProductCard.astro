---
// NOCTA showcase card: 3:4 photo, hairline border that lights up on hover,
// category centered on top (.3em tracking), name/price on the bottom row,
// square action buttons fade in on hover.
import type { Product } from '../lib/commerce';
import { PRODUCT_CARD as T } from '../constants/components';

interface Props {
  product: Product;
  /** Collection title shown centered at the top of the card */
  category?: string;
}
const { product, category } = Astro.props;
const img = product.images[0];
const onSale = !!product.compareAtPrice;
const firstAvailable = product.variants.find((v) => v.available) ?? product.variants[0];

const cartLine = JSON.stringify({
  variantId: firstAvailable?.id ?? product.id,
  productHandle: product.handle,
  title: product.title,
  variantTitle: firstAvailable?.title ?? 'Default',
  image: img,
  price: product.price,
  quantity: 1,
});
---

<a href={`/products/${product.handle}`} data-quickview={product.handle} class="group relative block overflow-hidden border border-white/10 bg-tile transition-colors duration-200 hover:border-white">
  <div class="aspect-[3/4]">
    {img && (
      <img
        src={img.src}
        alt={img.alt}
        class="h-full w-full object-cover opacity-90 transition duration-500 group-hover:opacity-100"
        loading="lazy"
      />
    )}
  </div>
  <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/10 to-black/40"></div>

  {category && (
    <p class="absolute inset-x-0 top-4 text-center text-[11px] uppercase tracking-[0.3em] text-white/70">
      {category}
    </p>
  )}

  {onSale && (
    <span class="absolute left-3 top-3 border border-white/40 bg-black/40 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-[0.14em] text-white">
      {T.saleBadge}
    </span>
  )}

  <!-- square hover actions -->
  <div class="card-actions absolute right-3 top-3 flex flex-col gap-2 opacity-0 transition duration-200 group-hover:opacity-100">
    <button
      type="button"
      data-cart-line={cartLine}
      data-quick-add
      onclick="event.preventDefault()"
      class="grid h-10 w-10 place-items-center border border-white/40 bg-black/40 text-white transition hover:border-white"
      aria-label={T.ariaAdd(product.title)}
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="9" cy="21" r="1.4" /><circle cx="19" cy="21" r="1.4" /><path d="M2.5 3h2l2.6 12.6a2 2 0 0 0 2 1.6h9.2a2 2 0 0 0 2-1.6L22 7H6" />
      </svg>
    </button>
    <button
      type="button"
      data-fav-toggle={product.handle}
      onclick="event.preventDefault()"
      class="grid h-10 w-10 place-items-center border border-white/40 bg-black/40 text-white transition hover:border-white"
      aria-label={T.ariaFav(product.title)}
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 20.5c-5.5-3.6-8.5-6.9-8.5-10.4A4.6 4.6 0 0 1 8.1 5.4c1.6 0 3 .8 3.9 2.1a4.7 4.7 0 0 1 3.9-2.1 4.6 4.6 0 0 1 4.6 4.7c0 3.5-3 6.8-8.5 10.4z" />
      </svg>
    </button>
  </div>

  <!-- bottom row: name left, price + go right -->
  <div class="absolute inset-x-0 bottom-0 flex items-baseline justify-between gap-3 p-4 text-white">
    <h3 class="min-w-0 truncate text-[15px] font-semibold uppercase tracking-[0.1em]">{product.title}</h3>
    <p class="flex shrink-0 items-baseline gap-1.5 text-[14px]">
      {onSale && <s class="text-[12px] text-white/50">${product.compareAtPrice!.amount}</s>}
      <span class="font-semibold tracking-wide">${product.price.amount}</span>
      <span class="text-[12px] uppercase tracking-[0.14em] text-white/60 transition group-hover:text-white">{T.goLabel}</span>
    </p>
  </div>
</a>
